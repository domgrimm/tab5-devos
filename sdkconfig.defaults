# Target Configuration for ESP32-P4
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_TARGET_ESP32P4=y

# CPU Clock & FreeRTOS Dual-Core Affinity
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000

# 32MB External PSRAM (ESP32-P4 uses HEX mode @ 200MHz)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Memory Reserve (Keep >120KB internal SRAM free for mbedTLS / Wi-Fi)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Cache / perf. (M5GFX's 256 KB L2 cache was tested and ruled out as a display
# flicker cause; the flicker was the IDF < 5.5.3 DSI timing bug, see bsp_tab5.c.)
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=n

# FAT long filenames. Without these only 8.3 names work on the SD card, so
# bookmarks.json, known_hosts, untitled-N.md, *.diff etc. fail with
# FR_INVALID_NAME and directory listings come back as upper-case short names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Per-core CPU load on the home screen (idle-task run-time counters, 64-bit
# so the microsecond counter never wraps).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS Task Stacks
# The main task is created BEFORE the scheduler starts, when only the small low
# internal-RAM region is usable (shared with ESP-Hosted's early tasks/queues).
# Keep it small: app_main only initialises NVS and starts the devos_boot task
# (main.c), whose 20 KB stack comes from the large post-scheduler region. A
# 16 KB main stack starved the idle-task stacks into TCM -> boot loop.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Primary Console over USB-C (Hardware CDC & JTAG)
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash Size: 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Disable LVGL Demos and Examples
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n

# LVGL Configuration & Fonts
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_UNSCII_8=y

# LVGL Memory & Logging
# LVGL's builtin allocator pool is *static internal RAM*. main.c adds 8 MB of
# PSRAM pools to LVGL at boot, so keep only a small fast internal pool here:
# at 256 KB it alone left < 120 KB internal RAM for mbedTLS / SSH / Wi-Fi.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
# LVGL's TLSF sizes its index from LV_MEM_SIZE + LV_MEM_POOL_EXPAND_SIZE, which
# caps both the pools that can be added AND the largest single lv_malloc().
# With a 64 KB pool alone that cap is 64 KB, and the 8 MB PSRAM pool main.c
# adds is rejected. Raise the cap without growing the static internal pool.
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=8192
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
# PNG decoding for the ADS-B map underlay (OpenStreetMap tiles)
CONFIG_LV_USE_LODEPNG=y

# --- Wi-Fi via ESP32-C6 co-processor (ESP-Hosted over SDIO) ---
# The ESP32-P4 has no radio; esp_wifi_remote proxies esp_wifi_* to the C6.
# Pins/reset are the M5Stack Tab5 wiring (from M5Tab5-UserDemo sdkconfig).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# Select the paired co-processor. This esp_wifi_remote choice is the real knob:
# esp_hosted derives its expected slave (ESP_HOSTED_CP_TARGET / IDF_SLAVE_TARGET)
# from it. Leaving it at the default (esp32) makes esp_hosted expect an "esp32"
# slave and abort with "Identified slave [esp32c6] != Expected [esp32]".
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8

# Wi-Fi on by default. (Ruled out as a flicker cause: the display flickered
# identically with Wi-Fi/SDIO off, so the C6 link is not the culprit.)
CONFIG_DEVOS_ENABLE_WIFI=y

# Compiler options - avoid treating format warnings as errors for third-party libraries on ESP32-P4
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y


# Tailscale (components/microlink, MicroLink v2). The ts2021 control channel is
# Noise_IK with ChaCha20-Poly1305 + HKDF from mbedTLS. WireGuard, DERP, STUN,
# DISCO and the control connection each hold sockets, alongside SSH sessions.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_ML_MAX_PEERS=32
# Cellular, WiFi/cellular switching and the HTTP config server stay off
# (devOS owns Wi-Fi and has its own UI).
CONFIG_ML_ENABLE_CELLULAR=n
CONFIG_ML_ENABLE_CONFIG_HTTPD=n

# OTA safety net: a freshly installed image boots "pending verify" and must
# confirm itself (devos_ota_mark_boot_ok, 15 s after the UI starts) or the
# next reset returns to the previous firmware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Camera: SC2356 (esp_cam_sensor "SC202CS") on MIPI CSI, RAW8 1280x720,
# used through IDF's CSI + ISP drivers (components/bsp_tab5/bsp_tab5_camera.c)
CONFIG_CAMERA_SC202CS=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT=y
CONFIG_CAMERA_SC202CS_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC202CS_MIPI_RAW8_1280x720_30FPS=y
