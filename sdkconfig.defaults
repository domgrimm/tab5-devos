# Target Configuration for ESP32-P4
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_TARGET_ESP32P4=y

# CPU Clock & FreeRTOS Dual-Core Affinity
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=360
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000

# 32MB External PSRAM (ESP32-P4 uses HEX mode @ 200MHz)
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_SPEED=200
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Memory Reserve (Keep >120KB internal SRAM free for mbedTLS / Wi-Fi)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# MIPI-DSI DPI-from-PSRAM bandwidth (fixes the display flicker/underrun).
# The DPI panel scans its framebuffer straight out of PSRAM with no bounce
# buffer, so anything else that reads PSRAM steals bandwidth from the pixel FIFO
# and causes underrun -> flicker (visible even on a static screen).
#
#   - 128-byte L2 cache lines: doubles the framebuffer DMA burst size so the
#     scanout reads far fewer, larger bursts. Key underrun fix, no internal-RAM
#     cost.
#   - PERF optimisation (-O2): faster code / shorter bus occupancy.
#
# Do NOT enable CONFIG_SPIRAM_XIP_FROM_PSRAM here: it relocates .text/.rodata
# into PSRAM, so every code/rodata fetch that misses L2 competes with the
# framebuffer scanout on the same bus -> constant underrun. M5 only gets away
# with it because it pairs XIP with a 256 KB L2 cache (keeps hot code cached);
# we can't afford that 256 KB (it would take 128 KB from this build's ~157 KB of
# free internal RAM and starve Wi-Fi/mbedTLS). With code left in flash (separate
# bus) the DPI keeps the PSRAM bandwidth it needs.
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
# DIAGNOSTIC (temporary): C6/Wi-Fi is OFF (see CONFIG_DEVOS_ENABLE_WIFI below),
# which frees the internal RAM the 256 KB L2 cache needs. This build tests
# whether the flicker is DPI-from-PSRAM underrun: with the SDIO link quiet AND
# the larger cache, the DPI has maximum PSRAM headroom. If the screen is clean,
# the flicker was bandwidth contention (revisit the Wi-Fi trade-off next).
# CONFIG_CACHE_L2_CACHE_256KB=y

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FreeRTOS Task Stacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Primary Console over USB-C (Hardware CDC & JTAG)
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash Size: 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Disable LVGL Demos and Examples
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n
CONFIG_LV_USE_DEMO_KEYPAD_AND_ENCODER=n
CONFIG_LV_USE_DEMO_BENCHMARK=n
CONFIG_LV_USE_DEMO_STRESS=n
CONFIG_LV_USE_DEMO_MUSIC=n

# LVGL Configuration & Fonts
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_UNSCII_8=y

# LVGL Memory & Logging
CONFIG_LV_MEM_SIZE_KILOBYTES=256
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y

# --- Wi-Fi via ESP32-C6 co-processor (ESP-Hosted over SDIO) ---
# The ESP32-P4 has no radio; esp_wifi_remote proxies esp_wifi_* to the C6.
# Pins/reset are the M5Stack Tab5 wiring (from M5Tab5-UserDemo sdkconfig).
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# Select the paired co-processor. This esp_wifi_remote choice is the real knob:
# esp_hosted derives its expected slave (ESP_HOSTED_CP_TARGET / IDF_SLAVE_TARGET)
# from it. Leaving it at the default (esp32) makes esp_hosted expect an "esp32"
# slave and abort with "Identified slave [esp32c6] != Expected [esp32]".
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PIN_D1=10
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8

# DIAGNOSTIC (temporary): Wi-Fi OFF to take the C6 SDIO link off the PSRAM bus
# and test whether the display flicker is bandwidth contention. This skips
# esp_wifi_init(), which is what brings up the SDIO master (see boot log ~3.7s),
# so the SDIO bus stays quiet. Set back to =y once the flicker cause is settled.
CONFIG_DEVOS_ENABLE_WIFI=n

# Compiler options - avoid treating format warnings as errors for third-party libraries on ESP32-P4
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

