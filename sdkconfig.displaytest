# THROWAWAY: layered on top of sdkconfig.defaults ONLY when DEVOS_DISPLAY_TEST=1
# (top-level CMakeLists.txt). Single-variable test vs the flickering 128 KB
# baseline: does M5GFX's 256 KB L2 cache remove the DPI scanout flicker?

# 256 KB L2 cache (M5GFX's value). Carved out of the 768 KB HP L2MEM, leaving
# 512 KB for internal .text/.data/.bss/heap.
CONFIG_CACHE_L2_CACHE_256KB=y

# LVGL's builtin allocator is a *static* pool in internal RAM; at 256 KB it alone
# leaves no room for the larger cache. The display test only creates the display
# object (the draw buffer is heap-allocated in PSRAM), so 64 KB is plenty.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
